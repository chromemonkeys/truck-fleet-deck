{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "*.md",
      "*.png",
      "dispatch.html",
      "index.html",
      "truck-drive.html",
      "The Forge.html"
    ],
    "rewrites": [
      { "source": "/", "destination": "/presentation.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(svg|glb)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      }
    ]
  }
}
